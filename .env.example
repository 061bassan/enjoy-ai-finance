# Provedor de dados: "local" (IndexedDB, padrão) ou "supabase".
VITE_DATA_PROVIDER=local

# Preenchidos apenas quando VITE_DATA_PROVIDER=supabase.
# A anon key é pública por natureza (o build a embute) — a segurança real é o
# RLS no banco. Nunca coloque aqui a service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
